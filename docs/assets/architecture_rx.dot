digraph G {
 graph [rankdir=TB, bgcolor="white", pad=0.2, nodesep=0.35, ranksep=0.33, dpi=170];
 node [shape=box, style="rounded,filled", fillcolor="#EDF3FA", color="#44668B", fontname="Noto Sans CJK SC", fontsize=12, margin="0.12,0.08"];
 edge [color="#536579", arrowsize=0.7, fontname="Noto Sans CJK SC", fontsize=10];
 iq [label="接收复数IQ capture"];
 sync [label="STF检测 / 粗CFO校正\nLTF匹配 / FFT窗选择 / 细CFO"];
 fft [label="总频偏校正 → 按窗口取256点\nFFT → 提取200个有效载波"];
 chan [label="LTF / MID信道估计\n噪声估计 + 可选去噪\n输出 H 与误差方差近似",fillcolor="#E8F4EB"];
 pilot [label="8导频相位 / 斜率跟踪\n校正头 / 数据载波",fillcolor="#E8F4EB"];
 head [label="头：BPSK LLR → 反帧头扰码\nLDPC → CRC16 / 字段 / 填充检查"];
 llr [label="载荷：匹配域 QPSK LLR\n符号内反交织 → 16×648项LLR"];
 dec [label="LDPC译码 → 反载荷扰码\nCRC32 / syndrome检查 → 644字节"];
 ok [label="r.ok / reason / payload\n只有成功帧交付业务"];
 vis [label="均衡星座\nr.equalized（观察支路）",style="rounded,dashed",fillcolor="white"];
 iq -> sync -> fft;
 fft -> chan [label="训练"];
 fft -> pilot [label="头 / 数据"];
 chan -> pilot [label="H"];
 pilot -> head [label="帧头"];
 pilot -> llr [label="载荷",constraint=false];
 head -> llr [label="头通过后才允许",style=dashed];
 chan -> llr [label="H / 可靠性",constraint=false];
 llr -> dec -> ok;
 head -> ok [label="失败返回",style=dashed];
 pilot -> vis [style=dashed];
}
